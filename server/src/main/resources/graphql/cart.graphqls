
extend type Query {

    getCart(userId: ID!): CartDto!

}

extend type Mutation {

    addItemToCart(userId: ID!, productId: ID!, quantity: Int!): CartResponse!

    removeItemFromCart(userId: ID!, productId: ID!): CartResponse!

    updateItemQuantity(userId: ID!, productId: ID!, newQuantity: Int!): CartResponse!


}

type CartDto {
    cartId: String
    userId: String
    totalPrice: Float
    cartItems: [CartItemDto]
}

type CartItemDto {
    cartItemId: String!
    quantity: Int
    unitPrice: Float
    totalPrice: Float
    product: ProductDto
}

type CartResponse {
    result: Boolean!
    message: String!
}



